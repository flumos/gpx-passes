{
  // Cloudflare Workers — statische Seite via Static Assets (kein Worker-Script nötig)
  "name": "gpx-passes",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./"
  },
  "routes": [
    { "pattern": "passjaeger.app", "custom_domain": true },
    { "pattern": "www.passjaeger.app", "custom_domain": true }
  ]
}
